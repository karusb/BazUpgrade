{
  "name": "BazUpgrade C++17",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "containerEnv": {
    "BAZUPGRADE_DEPENDENCY_PREFIX": "/workspaces/dependencies/installed"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cmake-tools",
        "ms-vscode.cpptools"
      ],
      "settings": {
        "cmake.configureOnOpen": false
      }
    }
  },
  "remoteUser": "vscode"
}
