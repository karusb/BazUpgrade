cmake_minimum_required(VERSION 3.25)
if(NOT DEFINED PACKAGE_DIR OR NOT DEFINED TOOLS_CONFIG)
    message(FATAL_ERROR "Pass PACKAGE_DIR and generated package-tools-<config>.cmake")
endif()
include("${TOOLS_CONFIG}")
file(GLOB archives "${PACKAGE_DIR}/*.zip" "${PACKAGE_DIR}/*.tar.gz")
if(NOT archives)
    message(FATAL_ERROR "No built release packages")
endif()
get_filename_component(package_root "${PACKAGE_DIR}" ABSOLUTE)
foreach(archive IN LISTS archives)
    string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
    set(extract "${package_root}/verification-${nonce}")
    if(EXISTS "${extract}")
        message(FATAL_ERROR "Refusing to reuse an extraction directory")
    endif()
    file(MAKE_DIRECTORY "${extract}")
    file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${extract}")
    file(GLOB_RECURSE candidates "${extract}/bazupgrade${EXE_SUFFIX}")
    list(FILTER candidates EXCLUDE REGEX "/share/")
    list(LENGTH candidates count)
    if(NOT count EQUAL 1)
        message(FATAL_ERROR "Expected one packaged updater in ${archive}")
    endif()
    list(GET candidates 0 updater)
    get_filename_component(bin "${updater}" DIRECTORY)
    get_filename_component(prefix "${bin}" DIRECTORY)
    foreach(tool bazupgrade bazupgrade-publish)
        execute_process(COMMAND "${bin}/${tool}${EXE_SUFFIX}" --version RESULT_VARIABLE result OUTPUT_VARIABLE version ERROR_VARIABLE error OUTPUT_STRIP_TRAILING_WHITESPACE)
        if(NOT result STREQUAL "0" OR NOT version STREQUAL BAZUPGRADE_VERSION)
            message(FATAL_ERROR "Packaged ${tool} failed version check: ${error}")
        endif()
    endforeach()
    file(GLOB_RECURSE private_sources "${prefix}/include/curlwrapper/*" "${prefix}/share/bazupgrade/third_party/CurlWrapper/*")
    if(private_sources)
        message(FATAL_ERROR "Private CurlWrapper source entered a public package")
    endif()
    file(GLOB sdk "${prefix}/bin/bazupgrade-sdk.dll" "${prefix}/lib/libbazupgrade-sdk.so" "${prefix}/lib/libbazupgrade-sdk.dylib")
    list(LENGTH sdk sdk_count)
    if(NOT sdk_count EQUAL 1)
        message(FATAL_ERROR "Expected a packaged C ABI library")
    endif()
    list(GET sdk 0 sdk_library)
    execute_process(COMMAND "${PACKAGE_PROBE}" --library "${sdk_library}" RESULT_VARIABLE result)
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "Packaged C ABI probe failed")
    endif()
    foreach(required include/bazupgrade/bazupgrade.h include/bazupgrade/BazUpgrade.hpp share/bazupgrade/LICENSE share/bazupgrade/docs/installation.md)
        if(NOT EXISTS "${prefix}/${required}")
            message(FATAL_ERROR "Package lacks ${required}")
        endif()
    endforeach()
    cmake_path(IS_PREFIX package_root "${extract}" NORMALIZE within_package_root)
    if(NOT within_package_root OR NOT extract MATCHES "/verification-[0-9a-f]+$")
        message(FATAL_ERROR "Refusing out-of-scope extraction cleanup")
    endif()
    file(REMOVE_RECURSE "${extract}")
    message(STATUS "${archive}: binaries, C ABI, public headers, license and private-source exclusion verified")
endforeach()
